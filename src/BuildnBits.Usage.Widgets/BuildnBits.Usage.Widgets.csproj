<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>BuildnBits.Usage.Widgets</RootNamespace>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <EnableCoreMrtTooling Condition=" '$(EnableCoreMrtTooling)' == '' ">false</EnableCoreMrtTooling>
    <Nullable>enable</Nullable>
    <StartupObject>BuildnBits.Usage.Widgets.ComServer</StartupObject>
    <Description>Windows 11 Widgets Board provider for combined Codex and Grok usage.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BuildnBits.Usage.Core\BuildnBits.Usage.Core.csproj" />
  </ItemGroup>
</Project>
